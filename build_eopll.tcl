# =============================================================================
# IP 4/4 — xadc_wiz_0  (다이 온도)
#   RTL 이 daddr_in=0x00(on-chip temperature) 을 DRP 로 직접 읽는다.
# =============================================================================
#   ★ 2026-09-03 : 처음에 ENABLE_TEMPERATURE_ALARM / ENABLE_VCCINT_ALARM /
#     ENABLE_VCCAUX_ALARM 을 껐다가 "Cannot find parameter" 로 실패했다.
#     2024.1 의 xadc_wiz 에는 그 이름이 없다(VCCPINT/VCCPAUX/VBRAM/VCCDDRO 만 있음).
#     그리고 나머지 기본값이 이미 우리가 원하는 것이라 건드릴 게 거의 없다 —
#     INTERFACE_SELECTION=ENABLE_DRP, XADC_STARUP_SELECTION=single_channel,
#     SINGLE_CHANNEL_SELECTION=TEMPERATURE 가 전부 기본값이다.
#     DCLK 만 200 MHz(clk_200_fixed)로 맞춘다.
#     alarm_out 계열은 RTL 에서 미연결(.alarm_out())이라 켜져 있어도 무해하다.
create_ip -name xadc_wiz -vendor xilinx.com -library ip -module_name xadc_wiz_0
set_property -dict [list \
    CONFIG.INTERFACE_SELECTION      {ENABLE_DRP} \
    CONFIG.XADC_STARUP_SELECTION    {single_channel} \
    CONFIG.SINGLE_CHANNEL_SELECTION {TEMPERATURE} \
    CONFIG.DCLK_FREQUENCY           {200} \
] [get_ips xadc_wiz_0]
puts "\[*\] xadc_wiz_0 : DRP, 온칩 온도, DCLK 200 MHz"

# ---------------------------------------------------------------- 출력 생성
puts "\[*\] IP 출력물 생성 중 (몇 분 걸린다)..."
# ★ 2026-09-04 : get_ips 는 블록 디자인 안에 들어 있는 IP 까지 전부 잡는다.
#   그걸 개별로 generate 하면 "Nested sub-design can only be generated by its
#   parent sub-design" 에러가 난다. 우리가 직접 만든 4개만 대상으로 하고,
#   블록 디자인은 .bd 파일 단위로 따로 생성한다.
set MY_IPS [get_ips clk_wiz_0 xadc_wiz_0]   ;# ★ 2026-09-05 : ila_0 제거 / ★ 2026-09-15 : tdc_calib_rom 제거
generate_target all $MY_IPS
catch { config_ip_cache -export $MY_IPS }
export_ip_user_files -of_objects $MY_IPS -no_script -sync -force -quiet
# create_ip_run 은 컬렉션을 안 받는다 ("A collection of objects is currently not
# supported"). IP 하나씩 돌려야 OOC 합성 run 이 만들어진다.
foreach ip $MY_IPS { create_ip_run $ip }

# 블록 디자인은 통째로 생성한다 (내부 IP 는 BD 가 알아서 만든다)
generate_target all [get_files eopll_sys.bd]
export_ip_user_files -of_objects [get_files eopll_sys.bd] -no_script -sync -force -quiet
puts "\[*\] IP [llength [get_ips]] 개 생성 완료 : [get_ips]"

# ---------------------------------------------------------------- 구현 전략
# ★ 2026-09-15 : 구현 전략 설정을 DO_BUILD 블록 밖으로 뺐다. 예전에는 세 번째 인자가 1 일 때만
#   걸려서, 0 으로 프로젝트만 만든 뒤 GUI 버튼으로 구현하면 기본 전략으로 돌아 hold 가 깨질 수
#   있었다(가이드 §5 에서 손으로 걸라고 따로 적어야 했던 이유). 이제 항상 걸어 둔다.
# ★ 2026-09-05 : 구현 전략을 기본값에서 Performance_ExplorePostRoutePhysOpt 로 바꾼다.
#   [무엇이 문제였나] PS7 + AXI 를 넣은 뒤 기본 전략으로는 hold 가 깨진다.
#     WHS = -0.045 ns, 위반 경로 captured_c0_stg2 -> stg3 (같은 clk_200_fixed 도메인).
#     원인은 지연이 아니라 스큐다 : 캐리체인 pblock 을 384탭 때문에 Y140 까지 넓히면서
#     체인 양끝의 클럭 도착 시각 차이(스큐 0.298 ns)가 데이터 지연(0.266 ns)을 넘어섰다.
#   [왜 이 전략인가] 이 전략은 route 뒤에 post_route_phys_opt_design 단계를 켠다
#     (EnableStepBool=1). 라우팅이 끝난 실제 지연을 보고 레지스터를 재배치·복제해
#     스큐를 줄이므로, 배치 단계의 추정치로만 판단하는 기본 전략이 못 잡는 hold 를 잡는다.
#   [결과] 2026-09-05 zed_axi 빌드 : WNS +0.089 / WHS +0.034 ns, 비트스트림 정상 생성.
#   [대가] 구현 시간이 늘어난다(단계가 하나 더 붙는다). 타이밍이 필수라 감수한다.
set_property strategy Performance_ExplorePostRoutePhysOpt [get_runs impl_1]
puts "\[*\] 구현 전략 : [get_property strategy [get_runs impl_1]]"

# ---------------------------------------------------------------- 합성 ~ 비트스트림 (선택)
# 세 번째 인자가 1 이면 합성 -> 구조 확인 -> 구현·비트스트림 -> 배치·타이밍 확인까지 이어서 한다.
set DO_BUILD 0
if {[info exists argv] && [llength $argv] >= 3} { set DO_BUILD [lindex $argv 2] }

# ★ 2026-09-15 : 확인 항목을 tcl/check_build.tcl 로 옮기고 PASS/FAIL 로 자동 판정한다 (사용자 요청).
#   [무엇이 문제였나] 여기서 찍던 "CARRY4 = N (기대 96)", "hit 네트 fanout = N" 은 숫자만 찍고
#     판정을 사람에게 맡겼는데 기대값이 틀렸다 (2026-09-15 보고서 §6-4 : 이름 필터에 먹스 LUT 이
#     걸려 97, FLAT_PIN_COUNT 는 구동 핀까지 세서 2). 그리고 탭 0 FF 가 제자리에서 밀려난 문제
#     (§6-5)는 어떤 확인에도 걸리지 않았다 — 09-06 빌드의 synth_1/impl_1 runme.log 에
#     CRITICAL WARNING 12-2285 는 0 건이었다 (GUI 에서 합성 디자인을 열 때만 뜬다).
#   [어떻게 바꿨나] 합성 뒤 구조(S1~S5), 구현 뒤 배치·타이밍(P1, P2, T1, T2, I1)을 판정해
#     vivado/<프로젝트>/build_check.txt 에 남긴다. 지연선 단수·탭 수(S1, S2)가 틀리면 비트스트림이
#     의미가 없으므로 구현을 돌리지 않고 멈춘다. 나머지 FAIL 은 비트스트림까지 가서 보고한다.
if {$DO_BUILD} {
    set CHECK_OUT [file join $PRJ_DIR build_check.txt]
    catch { file delete $CHECK_OUT }

    puts "\[*\] 합성 시작..."
    launch_runs synth_1 -jobs 8
    wait_on_run synth_1
    if {[get_property PROGRESS [get_runs synth_1]] != "100%"} {
        error "합성 실패 — vivado/<프로젝트>/…/runs/synth_1/runme.log 확인"
    }
    open_run synth_1 -name synth_1

    set CHECK_STAGE synth
    source [file join $SRC_ROOT tcl check_build.tcl]
    if {$CHECK_HARD_FAIL > 0} {
        error "구조 확인 실패 $CHECK_HARD_FAIL 건 (지연선 단수 또는 탭 수) — 비트스트림이 의미가 없어 구현을 돌리지 않는다. $CHECK_OUT 참조"
    }

    # =========================================================================
    # ★ 2026-09-21 — 핀맵 안전장치 (EOPLL 에서 추가한 유일한 절차 변경)
    #   DAC 핀에 LOC 가 없는 동안에는 구현·비트스트림으로 넘어가지 않는다.
    #   [왜] Vivado 는 핀이 안 박힌 I/O 를 write_bitstream 의 DRC(UCIO-1)로 막는데,
    #     그 DRC 를 낮춰서 통과시키면 Vivado 가 남는 핀에 임의로 배치한다. 그 비트스트림을
    #     실물에 올리면 어떤 핀이 구동될지 모른다 — 합친 보드에서는 DAC 나 비교기 입력에
    #     신호를 밀어 넣을 수도 있다. 그래서 통과시키지 않고 여기서 멈춘다.
    #   [푸는 법] 합친 보드 핀맵이 정해져 새 XDC 가 constrs_1 에 들어가면
    #     이 스크립트를 source 하기 전에  set EOPLL_PINMAP_READY 1  을 하면 된다.
    # =========================================================================
    set PINMAP_READY 0
    if {[info exists EOPLL_PINMAP_READY]} { set PINMAP_READY $EOPLL_PINMAP_READY }
    if {!$PINMAP_READY} {
        puts ""
        puts "=========================================================="
        puts " 합성과 구조 확인까지 끝냈다. 구현·비트스트림은 하지 않는다."
        puts "   이유 : DAC 핀(dac_sck/dac_cs_n/dac_sdio0..3/dac_ctrl_tri_io)에 LOC 가 없다."
        puts "          합친 보드의 FMC 핀맵이 아직 정해지지 않았다 (2026-09-21 보류)."
        puts "   확인 결과 : $CHECK_OUT"
        puts "   핀맵이 생기면 : set EOPLL_PINMAP_READY 1 ; set argv ... ; source build_eopll.tcl"
        puts "=========================================================="
        return
    }

    puts "\[*\] 구현 + 비트스트림 시작..."
    launch_runs impl_1 -to_step write_bitstream -jobs 8
    wait_on_run impl_1
    if {[get_property PROGRESS [get_runs impl_1]] != "100%"} {
        error "구현/비트스트림 실패 — vivado/<프로젝트>/…/runs/impl_1/runme.log 확인"
    }
    # ★ 2026-09-15 : 합성 디자인이 열린 채 open_run 을 또 부르면 오류가 날 수 있다 (CLAUDE.md Tcl 규칙 3).
    catch { close_design }
    open_run impl_1

    set CHECK_STAGE impl
    source [file join $SRC_ROOT tcl check_build.tcl]

    report_timing_summary -delay_type min_max -max_paths 5 \
        -file [file join $PRJ_DIR timing_summary.rpt]
    report_utilization -file [file join $PRJ_DIR utilization.rpt]

    # ★ 2026-09-15 : XSA 내보내기와 UART 뱅크 전압 확인까지 자동으로 한다 (회사 가이드용).
    #   [왜] 빌드 뒤 GUI 에서 File -> Export Hardware 를 손으로 하고, cmd 에서 findstr 로
    #     0x12E0 을 따로 확인하던 두 단계를 없앤다. 다음 단계(tcl/xsct_build_app.tcl)가
    #     vivado/<프로젝트>/tdc_zedboard_top.xsa 를 그대로 읽는다.
    #   [뱅크 전압] MIO48(UART1 TX) 설정 레지스터 0xF80007C0 의 값이 0x12E0(LVCMOS18)이어야 한다.
    #     0x16E0(LVCMOS33)이면 UART 수신이 죽는다 (2026-09-06, tcl/bd_ps_sys.tcl 주석).
    set XSA [file join $PRJ_DIR eopll_zedboard_top.xsa]
    if {[catch {write_hw_platform -fixed -include_bit -force -file $XSA} err]} {
        puts "\[!\] XSA 내보내기 실패 : $err"
        set XSA "(실패)"
    }
    set MIO_OK "확인 못 함"
    set p7 [lindex [glob -nocomplain [file join $PRJ_DIR ${PRJ_NAME}.gen sources_1 bd eopll_sys ip *ps7_0_0 ps7_init.tcl]] 0]
    if {$p7 ne ""} {
        set f7 [open $p7 r] ; set t7 [read $f7] ; close $f7
        if {[string match "*0XF80007C0 0x00003FFF 0x000012E0*" $t7]} {
            set MIO_OK "OK (0x12E0, LVCMOS18)"
        } else {
            set MIO_OK "★ 0x12E0 이 아니다 — UART 수신이 안 된다. tcl/bd_eopll_sys.tcl 의 뱅크 전압 확인"
        }
    }

    set BIT [lindex [glob -nocomplain [file join $PRJ_DIR ${PRJ_NAME}.runs impl_1 *.bit]] 0]
    puts ""
    puts "=========================================================="
    puts " 빌드 끝"
    puts "   비트스트림 : $BIT"
    puts "   XSA        : $XSA"
    puts "   UART 전압  : $MIO_OK"
    puts "   확인 결과  : $CHECK_OUT   (FAIL $CHECK_FAIL 건)"
    puts "   리포트     : $PRJ_DIR/timing_summary.rpt , utilization.rpt"
    if {$CHECK_FAIL > 0} {
        puts "   ★ FAIL 이 있다. 위 표(또는 build_check.txt)에서 FAIL 줄을 확인할 것."
    }
    puts " 보드에 올린 뒤 '1' 키로 교정표를 다시 만들 것 (측정 창이 빌드마다 옮겨간다)."
    puts "=========================================================="
} else {
    # ------------------------------------------------------------ 마무리 안내
    puts ""
    puts "=========================================================="
    puts " 프로젝트 생성 완료 : $PRJ_DIR"
    puts "=========================================================="
    puts " 다음 순서 (구현 전략은 이미 걸어 두었다):"
    puts "   1) Generate Bitstream (GUI 버튼)"
    puts "   2) Open Implemented Design 후 Tcl Console 에:"
    puts "        set CHECK_STAGE impl ; source $SRC_ROOT/tcl/check_build.tcl"
    puts "      FAIL 줄이 없어야 한다 (지연선 수, 탭 0 FF 위치, 먹스 위치, WNS/WHS 등)."
    puts ""
    puts " 하드웨어 확인 (J18 점퍼): FMC 뱅크 VCCO 를 2.5V 로 둘 것 (LVDS_25 + DIFF_TERM)"
    puts "=========================================================="
}
