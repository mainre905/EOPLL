# =============================================================================
# build_eopll.tcl  —  EOPLL 통합 프로젝트 생성 (ZedBoard XC7Z020-CLG484-1)
# Generated by Claude Code, 2026-09-21
#
#  TDC 저장소의 build_zedboard.tcl (커밋 f935720) 에서 아래만 바꾼 것이다.
#  IP 설정·구현 전략·확인 절차는 한 글자도 손대지 않았다 — 그 값들이 왜 그래야
#  하는지는 원문 주석에 그대로 남아 있다.
#
#    (1) 최상위      tdc_zedboard_top -> eopll_zedboard_top
#    (2) 블록 디자인 ps_sys (tcl/bd_ps_sys.tcl) -> eopll_sys (tcl/bd_eopll_sys.tcl)
#    (3) 소스에 RTL/dac_chirp_engine.v 추가 (BD 가 모듈 참조로 쓴다)
#    (4) 비트스트림 단계에 안전장치 추가 — 아래 [★ 핀 배치가 아직 없다] 참조
#
#  [★ 핀 배치가 아직 없다 — 2026-09-21 사용자 결정으로 보류]
#    합친 보드의 FMC 핀맵이 정해지지 않았다. 그래서 XDC 는 RTL/tdc_zedboard.xdc
#    하나만 넣는다. dac_sck / dac_cs_n / dac_sdio0..3 / dac_ctrl_tri_io 에는 LOC 가
#    없다. RTL/dac_test.xdc 는 EVAL-AD3552RFMCZ 기준이라 **쓰면 안 된다** —
#    합친 보드는 배선이 다르다.
#    Vivado 는 핀이 안 박힌 I/O 가 있으면 write_bitstream 에서 DRC(UCIO-1)로 멈춘다.
#    그것이 맞는 동작이다. 핀이 없는 채로 비트스트림을 뽑으면 Vivado 가 아무 핀에나
#    배치하고, 그 비트스트림을 실물에 올리면 엉뚱한 핀이 구동된다.
#    그래서 이 스크립트는 세 번째 인자가 1 이어도 **합성과 구조 확인까지만** 하고
#    멈춘다. 핀맵이 정해져 XDC 에 들어가면 EOPLL_PINMAP_READY 를 1 로 두면 된다.
#
#  [AXI 주소 — 합치면서 바뀐 것]
#    tdc_axi_regs     0x43C0_0000 (64K)  그대로
#    dac_chirp_engine 0x43C1_0000 (16K)  ★ 0x43C0_0000 에서 옮겼다 (TDC 와 겹쳤다)
#    axi_quad_spi     0x41E0_0000 / axi_gpio 0x4120_0000  그대로
#    -> ../DAC/vitis/dac_chirp.c:73 의 FSM_BASE 를 0x43C1_0000 으로 고쳐야 한다.
#
#  [사용법]  ★ Vivado GUI 의 Tcl Console 에서
#      cd <저장소 경로>
#      set argv 1 ; source build_eopll.tcl
#    ※ 경로 구분자는 '/' 다. Tcl 에서 '\' 는 이스케이프 문자다.
#
#    argv 첫 번째 = OPERATION_MODE (0/1/2, 기본 1)
#         두 번째 = 프로젝트 폴더 이름 (기본 vivado/eopll_mode<N>)
#         세 번째 = 1 이면 합성까지 이어서 실행 (핀맵 전까지는 비트스트림 안 만든다)
#
#  ▼ 아래는 원본 build_zedboard.tcl 의 설명이다 (그대로 보존).
# =============================================================================
#
#  [만들어지는 것]
#    - 소스를 **참조로** 추가 (복사 안 함 -> 이 저장소를 고치면 바로 반영)
#    - IP 2개 : clk_wiz_0 / xadc_wiz_0
#    - 최상위 eopll_zedboard_top, generic 으로 OPERATION_MODE 전달
#
#  ★ 주의 — IP 프로퍼티 이름은 Vivado 버전에 따라 조금씩 다르다.
#    이 스크립트는 2024.1 기준으로 썼다.
#
#  [검증 상태]
#    ★ 이 스크립트는 **아직 Vivado 에서 한 번도 돌려 보지 않았다** (Orin 에 Vivado 가 없다).
#      RTL 쪽은 sim/run_iverilog_eopll.sh 로 최상위 엘러보레이션까지 통과했다.
# =============================================================================

# ---------------------------------------------------------------- 인자 처리
set OP_MODE 1
if {[info exists argv] && [llength $argv] >= 1} { set OP_MODE [lindex $argv 0] }
if {$OP_MODE < 0 || $OP_MODE > 2} { error "OPERATION_MODE 는 0/1/2 여야 한다: $OP_MODE" }

set SRC_ROOT [file normalize [file dirname [info script]]]
set PRJ_NAME "eopll_mode$OP_MODE"
if {[info exists argv] && [llength $argv] >= 2} { set PRJ_NAME [lindex $argv 1] }
set PRJ_DIR  [file join $SRC_ROOT vivado $PRJ_NAME]

# ★ 2026-09-15 : 네 번째 인자 HIT_INPUT(0=FMC LVDS / 1=PMOD 단선 Y11) 처리 삭제.
#   2026-09-05 에 STM32 임시 신호원용으로 넣었으나 Mode 2 신호원이 LVDS 비교기 하나로
#   확정됐다. 인자를 빠뜨리면 의도와 다른 입력으로 빌드되는 실수만 남았다
#   (2026-09-06 zed_uart). tdc_zedboard_top.v 의 파라미터 삭제 주석 참조.

# 384탭(96단) 기준. 체인 단수를 바꾸면 python/gen_chain_xdc.py 와 함께 여기도 고칠 것.
set CHAIN_STAGES 96
set NUM_TAPS     [expr {$CHAIN_STAGES * 4}]
# ★ 2026-09-15 : COE_FILE 제거. 교정표는 이제 PS 가 Mode 1 히스토그램으로 계산해
#   tdc_calib_ram(RTL)에 AXI 로 쓴다. 빌드에 COE 가 필요 없다.

puts "=========================================================="
puts " ZedBoard 프로젝트 생성"
puts "   소스 루트     : $SRC_ROOT"
puts "   프로젝트      : $PRJ_DIR"
puts "   OPERATION_MODE: $OP_MODE   (0=DPS스윕 / 1=링오실레이터 / 2=외부입력)"
puts "   히트 입력     : FMC LVDS E21/D21 (J18 = 2.5 V)"
# ★ 2026-09-15 : HIT_INPUT 출력 삭제 (변수 자체를 없앴다).
puts "   캐리체인      : ${CHAIN_STAGES}단 = ${NUM_TAPS}탭"
puts "=========================================================="


# ---------------------------------------------------------------- 프로젝트
# ★ 2026-09-21 추가 — 열려 있는 것을 먼저 닫는다 (CLAUDE.md 의 Tcl 규칙 3).
#   GUI Tcl Console 에서 이어서 돌릴 때, 앞 프로젝트가 열려 있으면 Windows 가 파일을
#   잠그고 있어 create_project 가 실패한다. 열린 것이 없으면 catch 가 조용히 넘어간다.
catch { close_design }
catch { close_project }

if {[file exists $PRJ_DIR]} {
    error "이미 있다: $PRJ_DIR\n  지우거나 두 번째 인자로 다른 이름을 줄 것."
}
create_project $PRJ_NAME $PRJ_DIR -part xc7z020clg484-1 -force
set_property target_language Verilog [current_project]

# ---------------------------------------------------------------- 소스 추가
# ★ 복사하지 않고 참조로 넣는다. 저장소의 .v 를 고치면 프로젝트에 바로 반영된다.
set VSRC [list \
    [file join $SRC_ROOT RTL eopll_zedboard_top.v] \
    [file join $SRC_ROOT RTL tdc_test_top.v]       \
    [file join $SRC_ROOT RTL tdc_fmcw_core_co.v]   \
    [file join $SRC_ROOT RTL tdc_timestamp_calc.v] \
    [file join $SRC_ROOT RTL tdc_calib_ram.v]      \
    [file join $SRC_ROOT RTL tdc_histogram.v]      \
    [file join $SRC_ROOT RTL phase_shifter.v]      \
    [file join $SRC_ROOT RTL dna_reader.v]         \
    [file join $SRC_ROOT RTL tdc_axi_regs.v]       \
    [file join $SRC_ROOT RTL tdc_seq.v]            \
    [file join $SRC_ROOT RTL tdc_capture.v]        \
    [file join $SRC_ROOT RTL dac_chirp_engine.v]   \
]
# ★ dac_stream_spi.v 는 넣지 않는다. AXI4-Stream 을 받던 예전 판이고,
#   지금 구조(PS 가 온칩 BRAM 에 파형을 쓰고 dac_chirp_engine 이 읽는다)에서는
#   어디에도 인스턴스되지 않는다. 참고용으로 RTL/ 에 두기만 한다.
foreach f $VSRC { if {![file exists $f]} { error "소스 없음: $f" } }
add_files -norecurse -fileset sources_1 $VSRC
set_property is_global_include false [get_files $VSRC]

set XDCF [file join $SRC_ROOT RTL tdc_zedboard.xdc]
if {![file exists $XDCF]} { error "XDC 없음: $XDCF" }
add_files -norecurse -fileset constrs_1 $XDCF
# ★ RTL/dac_test.xdc 는 일부러 넣지 않는다 — EVAL-AD3552RFMCZ 기준이라
#   합친 보드에서는 틀린 핀이다. 핀맵이 정해지면 새 XDC 를 만들어 여기 추가할 것.
puts "\[!\] DAC 핀(dac_sck/dac_cs_n/dac_sdio0..3/dac_ctrl_tri_io)에 LOC 가 없다 — 핀맵 미정"

# ---------------------------------------------------------------- 블록 디자인
#  ★ 2026-09-04 추가 : PS7 + proc_sys_reset + AXI 인터커넥트.
#    TDC 의 클럭(FCLK_CLK0)도 여기서 나온다. 상세는 tcl/bd_ps_sys.tcl 참조.
source [file join $SRC_ROOT tcl bd_eopll_sys.tcl]
make_wrapper -files [get_files eopll_sys.bd] -top
add_files -norecurse [file join $PRJ_DIR ${PRJ_NAME}.gen sources_1 bd eopll_sys hdl eopll_sys_wrapper.v]
puts "\[*\] 블록 디자인 eopll_sys 생성 + 래퍼 추가"

set_property top eopll_zedboard_top [current_fileset]
# ★ 2026-09-15 : generic 에서 HIT_INPUT 삭제 (top 에 그 파라미터가 없어졌다).
set_property generic "OPERATION_MODE=$OP_MODE" [current_fileset]
update_compile_order -fileset sources_1
puts "\[*\] 소스 [llength $VSRC]개 + XDC 1개 추가 완료. 최상위 = eopll_zedboard_top, OPERATION_MODE=$OP_MODE"

# =============================================================================
# IP 1/4 — clk_wiz_0
#   ★ 이 프로젝트에서 제일 중요한 설정이다.
#     phase_shifter.v 의 위상 스텝 = VCO 주기의 1/56 = 17.857 ps 이고,
#     이 값이 Mode 0 의 '참 시간축' 이다. VCO 가 1000 MHz 가 아니면 교정 계산이
#     전부 틀어진다. 100 MHz x 10 / 1 = 1000 MHz, ÷5 = 200 MHz.
#     Vivado 가 다른 M/D 조합을 제안해도 아래 값이 우선이다.
# =============================================================================
#   ★ 2026-09-04 : PRIM_SOURCE 가 Global_buffer 다. 입력이 Y9 외부 핀에서
#     PS 의 FCLK_CLK0(내부 클럭)으로 바뀌었기 때문이다. 핀용 설정을 그대로
#     두면 쓸데없는 IBUF 가 끼어든다.
create_ip -name clk_wiz -vendor xilinx.com -library ip -module_name clk_wiz_0
set_property -dict [list \
    CONFIG.PRIM_IN_FREQ                {100.000} \
    CONFIG.PRIM_SOURCE                 {Global_buffer} \
    CONFIG.PRIMITIVE                   {MMCM} \
    CONFIG.NUM_OUT_CLKS                {2} \
    CONFIG.CLKOUT2_USED                {true} \
    CONFIG.CLKOUT1_REQUESTED_OUT_FREQ  {200.000} \
    CONFIG.CLKOUT2_REQUESTED_OUT_FREQ  {200.000} \
    CONFIG.MMCM_DIVCLK_DIVIDE          {1} \
    CONFIG.MMCM_CLKFBOUT_MULT_F        {10.000} \
    CONFIG.MMCM_CLKOUT0_DIVIDE_F       {5.000} \
    CONFIG.MMCM_CLKOUT1_DIVIDE         {5} \
    CONFIG.USE_DYN_PHASE_SHIFT         {true} \
    CONFIG.CLK_OUT2_USE_FINE_PS_GUI    {true} \
    CONFIG.USE_RESET                   {true} \
    CONFIG.RESET_TYPE                  {ACTIVE_HIGH} \
    CONFIG.USE_LOCKED                  {true} \
] [get_ips clk_wiz_0]

# ★ 2026-09-16 : fine phase shift 를 clk_out2 에만 켠다 — 안 켜면 위상이 전혀 안 움직인다.
#   [무엇이 문제였나] 2026-09-03 이 스크립트가 IP 를 만들기 시작한 뒤로 USE_DYN_PHASE_SHIFT
#     만 true 였고, 출력별 USE_FINE_PS 는 전부 false 였다 (2026-09-16 zed_m0b 프로젝트에서
#     get_property 로 확인). MMCM 의 fine phase shift 는 USE_FINE_PS 가 켜진 출력에만
#     반영되므로, psen 을 넣어도 클럭은 그대로였다. 그런데 psdone 은 정상적으로 돌아와서
#     phase_shifter.v 도 앱도 "이동 성공" 으로 보였다 (phase_cur 는 명령한 스텝을 세는
#     카운터일 뿐이다). 그래서 2026-09-16 키 3 측정에서 위상 0/70/140/210 스텝의
#     timestamp mod 5000 이 전부 2123~2152 ps 로 같았다 (기대는 1250 ps 씩 이동).
#   [왜 clk_out2 만인가] 히트 생성기가 clk_200_shifted(clk_out2)에서 돌고 샘플링은
#     clk_200_fixed(clk_out1)로 한다. 둘 다 켜면 VCO 위상이 함께 움직여 상대 위상이
#     그대로다 — 즉 아무것도 안 켠 것과 같은 결과가 된다.
#   [스텝 크기] VCO 주기의 1/56 = 17.857 ps (phase_shifter.v 의 전제).
set _fps2 [get_property CONFIG.MMCM_CLKOUT1_USE_FINE_PS [get_ips clk_wiz_0]]
set _fps1 [get_property CONFIG.MMCM_CLKOUT0_USE_FINE_PS [get_ips clk_wiz_0]]
puts "\[*\] fine PS : clk_out2(MMCM_CLKOUT1) = $_fps2,  clk_out1(MMCM_CLKOUT0) = $_fps1"
if {![string match -nocase "true" $_fps2]} {
    error "clk_out2 에 fine phase shift 가 안 켜졌다 ($_fps2). 이러면 위상 이동이 아무 효과가 없다."
}
if {[string match -nocase "true" $_fps1]} {
    error "clk_out1(샘플링 클럭)에도 fine PS 가 켜졌다. 둘 다 켜지면 상대 위상이 안 움직인다."
}

set _m [get_property CONFIG.MMCM_CLKFBOUT_MULT_F [get_ips clk_wiz_0]]
set _d [get_property CONFIG.MMCM_DIVCLK_DIVIDE   [get_ips clk_wiz_0]]
set _vco [expr {100.0 * $_m / $_d}]
puts "\[*\] clk_wiz_0 : M=$_m D=$_d  ->  VCO = $_vco MHz"
if {abs($_vco - 1000.0) > 0.001} {
    error "VCO 가 $_vco MHz 다. 1000 MHz 여야 한다 — phase_shifter.v 의 17.857 ps 가 깨진다."
}
puts "\[*\] 위상 스텝 = 1000/56 = [format %.4f [expr {1000.0/56.0}]] ps  (Mode 0 참 시간축) OK"

